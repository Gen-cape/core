export NIXPKGS_ALLOW_UNFREE := env_var_or_default("NIXPKGS_ALLOW_UNFREE", "1")

# Helper to chain stuff, so I can just unfree sub ... any command
[private]
run-wrapped +cmd:
    #!/usr/bin/env bash
    set -euo pipefail
    # Read words into an array safely
    read -r -a args <<< "{{cmd}}"
    target="${args[0]}"

    if just -f "{{justfile()}}" --summary | tr ' ' '\n' | grep -qx "$target"; then
        exec just -f "{{justfile()}}" "${args[@]}"
    elif just --summary 2>/dev/null | tr ' ' '\n' | grep -qx "$target"; then
        exec just "${args[@]}"
    else
        exec "${args[@]}"
    fi

# Load ~/subs.conf into NIX_CONFIG
subs +cmd:
    #!/usr/bin/env bash
    set -euo pipefail
    target="${HOME}/subs.conf"
    if [ -f "$target" ]; then
        extra_cfg="$(cat "$target")"
        export NIX_CONFIG="$(printf '%s\n%s' "${NIX_CONFIG:-}" "$extra_cfg")"
    fi
    exec just -f "{{justfile()}}" run-wrapped {{cmd}}

# Disable binary substituters (build from source)
nosub +cmd:
    #!/usr/bin/env bash
    export NIX_CONFIG="$(printf '%s\n' "${NIX_CONFIG:-}" "substitute = false")"
    exec just -f "{{justfile()}}" run-wrapped {{cmd}}

# Allow unfree packages
unfree +cmd:
    #!/usr/bin/env bash
    export NIXPKGS_ALLOW_UNFREE="1"
    exec just -f "{{justfile()}}" run-wrapped {{cmd}}

# Drop into a temporary shell
shell +packages:
    #!/usr/bin/env bash
    set -euo pipefail
    resolve_pkg() {
        [[ "$1" =~ [#:/] || "$1" =~ ^\. ]] && echo "$1" || echo "nixpkgs#$1"
    }
    pkgs=()
    for p in {{packages}}; do pkgs+=("$(resolve_pkg "$p")"); done
    nix shell --impure "${pkgs[@]}"

# Install packages into profile
install +packages:
    #!/usr/bin/env bash
    set -euo pipefail
    resolve_pkg() {
        [[ "$1" =~ [#:/] || "$1" =~ ^\. ]] && echo "$1" || echo "nixpkgs#$1"
    }
    pkgs=()
    for p in {{packages}}; do pkgs+=("$(resolve_pkg "$p")"); done
    nix profile install --impure "${pkgs[@]}"

# Run package binary with args
run package *args:
    #!/usr/bin/env bash
    set -euo pipefail
    target="{{package}}"
    [[ "$target" =~ [#:/] || "$target" =~ ^\. ]] || target="nixpkgs#$target"
    nix run --impure "$target" -- {{args}}

# Upgrade profile packages
upgrade *packages:
    #!/usr/bin/env bash
    set -euo pipefail
    [ -z "{{packages}}" ] && nix profile upgrade --impure '.*' || nix profile upgrade --impure {{packages}}
