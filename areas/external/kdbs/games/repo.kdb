(deflayermap (repo)
    f (macro-repeat ( mwheel-up 1 2000  ))
    ;;caps (macro-repeat ( mwheel-down 25 2000  ))
    v (macro-repeat (mlft 10 e 25))
    g f

  k (on-press press-vkey mlft)
  l (on-press release-vkey mlft)
    ;;repo-game-fast-rotate (macro-repeat
    ;;    (on-press press-vkey)
    ;;)

    caps (multi mouseright (movemouse-down 1 10) )
    ;;caps (macro-repeat
    ;;      (on-press press-vkey mlft)
    ;;      (on-press press-vkey mrgt) 40
    ;;      (hold-for-duration 1000 mvup) 1000
    ;;      (on-release release-vkey mlft)
    ;;      (on-release release-vkey mrgt) 50
    ;;
    ;;)
    5 (multi mouseright (movemouse-left 1 20) )
   ;; lctl (macro 
   ;;          (hold-for-duration 300 sft) 270
   ;;          (hold-for-duration 30 ctl)
   ;;     )
      lctl (macro 
             (hold-for-duration 300 sft) 230
	     (hold-for-duration 30 ctl)
	)
	alt (macro
        (hold-for-duration 300 sft) 230
		(hold-for-duration 30 ctl) 30
		(hold-for-duration 50 spc) 50
		(hold-for-duration 30 q) 230
		(hold-for-duration 30 q) 30 60
		(hold-for-duration 30 q) 30 60
		(hold-for-duration 30 q) 30 60
		(hold-for-duration 30 q) 30 60
		(hold-for-duration 30 q) 30 60
		(hold-for-duration 30 q) 30 60
		(hold-for-duration 30 q) 30 60
		(hold-for-duration 30 q) 30 60
		(hold-for-duration 30 q) 30 60
		(hold-for-duration 30 q) 30 60
	)
	t (multi
		(on-press press-vkey sft)
		(macro 
				(hold-for-duration 75 mvrt) 75
		)
		(on-release release-vkey sft)
	)
    c lctl
    r (macro
    	(on-press press-vkey mlft)

	(hold-for-duration 300 mwdf) 300
	(hold-for-duration 300 mwuf) 300

        (on-press release-vkey mlft)
    )
    
)

(defvirtualkeys
  mvup (movemouse-up 1 27)
  mvrt (movemouse-right 1 40)
  mwdf (mwheel-down 1 100)
  mwuf (mwheel-up 1 100)
)

