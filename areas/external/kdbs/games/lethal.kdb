(deflayermap (lethal)
  ;;w (macro-repeat mlft 25)
  w (macro-repeat mltp 25)
  a (macro-repeat r 1)
  q (macro-repeat r mlft 1)
  8 (tap-hold 200 200 rsft (layer-switch lethal-jump) )
)


(deftemplate lethal-jump-movement (direction jump forward brake vkey-name)
  
  (defvirtualkeys
    $vkey-name (macro
      (on-press release-vkey  $brake    ) 3
      ;;(hold-for-duration 50 $forward  ) 100
      (hold-for-duration 60   $direction) 30
      (hold-for-duration 30   $jump     )
    )
  )

  (defalias
    $vkey-name (on-release tap-virtualkey $vkey-name)
  )
)

(t! lethal-jump-movement    e    g e spc lethal-jump-fwd)   
(t! lethal-jump-movement    s    g e spc lethal-jump-left)  
(t! lethal-jump-movement    d    g e spc lethal-jump-bwd)   
(t! lethal-jump-movement    f    g e spc lethal-jump-right) 



(deflayermap (lethal-jump)
  [ (on-press   press-vkey  spc)
  ] (on-press release-vkey  spc)
  p (macro
      (on-press press-vkey spc) 5
      (hold-for-duration 10 e) 10
      (on-press release-vkey spc)
    )
  u (macro
      ;;(release-key spc)
      (hold-for-duration 120 spc) 30 (hold-for-duration 60 e) 130
      (on-press release-vkey spc) 3
      (hold-for-duration 30 g) 220
      (hold-for-duration 30 g) 700
      (hold-for-duration 60 s) 30 (hold-for-duration 30 g) 700
      (hold-for-duration 60 s) 30 (hold-for-duration 30 g) 750
      (hold-for-duration 60 s) 30 (hold-for-duration 30 g) 750
  )

  y (macro
      ;;(release-key spc)
      (hold-for-duration 120 spc) 30 (hold-for-duration 60 e) 130
      (on-press release-vkey spc) 3
      (hold-for-duration 60 f) 30 (hold-for-duration 30 g) 220
      (hold-for-duration 60 f) 30 (hold-for-duration 30 g) 320
      (hold-for-duration 60 f)    (hold-for-duration 60 d) 30  (hold-for-duration 30 g) 800
      (hold-for-duration 60 f) 30 (hold-for-duration 30 g) 750
      (hold-for-duration 60 s)    (hold-for-duration 60 e) 30  (hold-for-duration 30 g)
  )

  t (macro
      ;;(release-key spc)
      (hold-for-duration 120 spc) 30 (hold-for-duration 60 e) 130
      (on-press release-vkey spc) 3
      (hold-for-duration 60 s) 30 (hold-for-duration 30 g) 220
      (hold-for-duration 60 s) 30 (hold-for-duration 30 g) 320
      (hold-for-duration 60 s)    (hold-for-duration 60 e) 30  (hold-for-duration 30 g) 800
      (hold-for-duration 60 s) 30 (hold-for-duration 30 g) 750
      (hold-for-duration 60 f)    (hold-for-duration 60 d) 30  (hold-for-duration 30 g)
  )



	;;e @lethal-jump-fwd
  ;;s @lethal-jump-left
  ;;d @lethal-jump-bwd
  ;;f @lethal-jump-right

  ;;;;i (layer-switch lethal)
)
