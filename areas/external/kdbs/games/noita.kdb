(defalias
  ;; noita
  ;;old_tablet (macro x @6 f 100 mrgt @2 160 @5 s @6 mrgt 104 @6)
)

(deflayermap (noita)
  q (macro-repeat ( mwheel-down 5 120 ) 20 @1 20 mlft)
  z (macro @6 10 @6 f 100 mrgt @1 160 @6 5 s 5 @6 5 mrgt 5 @6 10 @6)
  x (macro @7 10 @7 f 100 mrgt @1 160 @7 5 s 5 @7 5 mrgt 5 @7 10 @7)
  v (macro f 100 mrgt @2 160 @5 s @6 mrgt)
  b (macro s @6 mrgt)
  caps (macro-repeat @1 20 mlft 5 @2 20 mlft 5 @3 20 mlft 5)
  t (macro-repeat (movemouse-left 5 6) 10 (movemouse-right 5 6) 10)
  p (macro m 20 o 20 t 20 h 20 e 20 r 20 l 20 o 20 d 20 e)
  [ (macro s 20 e 20 c 20 o 20 n 20 d 20 a 20 m 20 e 20 n 20 d 20 m 20 e 20 n 20 t)

)
