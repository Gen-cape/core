(defalias
  ;; noita
  ;;old_tablet (macro x @6 f 100 mrgt @2 160 @5 s @6 mrgt 104 @6)
  tablet(macro @6 10 @6 f 100 mrgt @1 160 @6 5 s 5 @6 5 mrgt 5 @6 10 @6)
  tablet_2(macro @7 10 @7 f 100 mrgt @1 160 @7 5 s 5 @7 5 mrgt 5 @7 10 @7)

  tablet_v (macro f 100 mrgt @2 160 @5 s @6 mrgt)
  tablet_b (macro s @6 mrgt)

  mwd_noita (mwheel-down 5 120)
  first_spell (macro-repeat @mwd_noita 20 @1 20 mlft)
  potion_noita (macro-repeat (movemouse-left 5 6) 10 (movemouse-right 5 6) 10)
)

(deflayermap (noita)
  q @first_spell
  z @tablet
  x @tablet_2
  v @tablet_v
  b @tablet_b
  t @potion_noita
  p (macro m 20 o 20 t 20 h 20 e 20 r 20 l 20 o 20 d 20 e)
  [ (macro s 20 e 20 c 20 o 20 n 20 d 20 a 20 m 20 e 20 n 20 d 20 m 20 e 20 n 20 t)

)
