(defalias
  ;; Macros/Soft

  ;; noita
  ;;old_tablet (macro x @6 f 100 mrgt @2 160 @5 s @6 mrgt 104 @6)
  tablet(macro @6 10 @6 f 100 mrgt @1 160 @6 5 s 5 @6 5 mrgt 5 @6 10 @6)
  tablet_2(macro @7 10 @7 f 100 mrgt @1 160 @7 5 s 5 @7 5 mrgt 5 @7 10 @7)

  tablet_v (macro f 100 mrgt @2 160 @5 s @6 mrgt)
  tablet_b (macro s @6 mrgt)

  mwd_noita (mwheel-down 5 120)
  first_spell (macro-repeat @mwd_noita 20 @1 20 mlft)
  potion_noita (macro-repeat (movemouse-left 5 6) 10 (movemouse-right 5 6) 10)


  ;; drg

  lsft-f24 (tap-hold $tt $ht lsft f24)
  lmb (macro-repeat mlft 10)
  lmb-b (macro-repeat mlft 1)
  lmb-e (macro-repeat mlft 110 lctl 600)

  nade (macro-repeat 20 q 20 g 100)
  ustck (macro-repeat a d)
  dpst (macro-repeat e lctl 1)

  spam-e (macro-repeat e 10)
  spam-spc (macro-repeat spc)
  zipline-drg (multi w @spam-e @spam-spc)

  sjump_init (macro spc 20 mlft 2 e 2 e 2 e 2 e 2 e 2 e 2 e 2 e)
  sjump_init_double (macro spc 20 mlft 2 lctl 40 mlft e 2 e 2 e 2 e 2 e 2 e 2 e 2 e 2 e 2 e 2 e 2 e 2 e 2 e 2 e 2 e 2 e 2 e 2 e 2 e 2 e 2 e 2 e 2 e 2 e 2 e 2 e)

  spam_e_sp (macro-repeat e 5 spc)
  ;;bhop_item_d (macro-repeat e 5 spc 1 mlft 1 lctl 110)
  bhop_item_d (macro-repeat e 5 spc 1 mrgt  3 1 lctl 30)

  drg-lalt (switch
    (w) @bhop_item_d break
    () f23 break
  )
  drg-e (switch
    (caps lsft f24) @dpst break
    (lalt f23) @spam_e_sp break
    () e break
  )

  drg-r (switch
    (lalt f23) @sjump_init break
    () r break
  )

  drg-zip (switch
    (caps lsft f24) f break
    (lalt f23) @sjump_init_double break
    () @zipline-drg break
  )

  drg-spc (switch
    (caps lsft f24) spc break
    () @spam-spc break
  )

  drg-lm (switch
    (caps lsft f24) @lmb-e break
    (lalt f23) @sjump_init break
    () @lmb break
  )

  drg-[ (switch
    (caps lsft lalt f23 f24) (multi lsft [) break
    () [ break
  )

)
