(defsrc
  esc
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lmet lalt           spc            ralt rmet rctl
)

(deflayer qwr_clean
  esc
  grv 1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  f24 a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    @slsh    rsft
  lctl lmet lalt           spc            ralt rmet rctl
)

(deflayer qwerty
  @chesc
  @chgrl 1     2    3    4    5    6    7    8    9    0    -    =    bspc
  @chtb  q     w    e    r    t    y    u    i    o    p    [    ]    \
  @cap   a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    @slsh    @rsft-t
  lctl lmet @lalt-t           spc            @cwc rmet @rcl
)

(deflayer qwr_pure
  esc
  grv 1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    @slsh    rsft
  lctl lmet lalt           spc            ralt rmet rctl
)

(deflayer ru
  @chesc
  @grl     _     _     _     _     _     _     _     _     _     _     _     _     _
  @chtb     @й     @ц     @у     @к     @ru-e     @н     @г     @ш     @щ     @з     @х     @ъ    _
  @cap-ru-1  @ф     @ы     @в     @а     @п     @р     @о     @л     @д     @ж     @э     _
  @shft-ru     @я     @ч     @с     @м     @и     @т     @ь     @б     @ю     @slsh     _
  @ctrl-ru     _     _                 @spc                 _     _     _
)

(deflayer ru-cap
  @chesc
  @grl     _     _     _     _     _     _     _     _     _     _     _     _     _
  @chtb     @Й     @Ц     @У     @К     @ru-E     @Н     @Г     @Ш     @Щ     @З     @Х     @Ъ    _
  @cap-ru-2  @Ф     @Ы     @В     @А     @П     @Р     @О     @Л     @Д     @Ж     @Э     _
  _     @Я     @Ч     @С     @М     @И     @Т     @Ь     @Б     @Ю     @slsh     _
  @ctrl-ru     _     _                 _                 _     _     _
)

(deflayer dvorak
  esc
  @grl 1    2    3    4    5    6    7    8    9    0    [    ]    bspc
  tab  '    ,    .    p    y    f    g    c    r    l    /    =    \
  @cap a    o    e    u    i    d    h    t    n    s    -    ret
  lsft ;    q    j    k    x    b    m    w    v    z    rsft
  lctl lmet lalt           spc            ralt rmet rctl
)
