(defalias
  cap-ru-1 (layer-switch ru-cap)
  cap-ru-2 (layer-switch ru)
  ctrl-ru (multi lctl (layer-while-held qwr_clean))
  shft-ru (multi lsft (layer-while-held ru-cap))
  spc (tap-hold $tt $ht  spc (layer-toggle vim))
)

(deflayer ru
  mlft mrgt mmid mfwd mbck mwu mwd mwl mwr
  esc
  @grl     _     _     _     _     _     _     _     _     _     _     _     _     _
  tab     @й     @ц     @у     @к     @ru-e     @н     @г     @ш     @щ     @з     @х     @ъ    _
  @cap-ru-1  @ф     @ы     @в     @а     @п     @р     @о     @л     @д     @ж     @э     _
  @shft-ru     @я     @ч     @с     @м     @и     @т     @ь     @б     @ю     _     _
  @ctrl-ru     _     _                 @spc                 _     _     _
)

(deflayer ru-cap
  mlft mrgt mmid mfwd mbck mwu mwd mwl mwr
  esc
  @grl     _     _     _     _     _     _     _     _     _     _     _     _     _
  tab     @Й     @Ц     @У     @К     @ru-E     @Н     @Г     @Ш     @Щ     @З     @Х     @Ъ    _
  @cap-ru-2  @Ф     @Ы     @В     @А     @П     @Р     @О     @Л     @Д     @Ж     @Э     _
  _     @Я     @Ч     @С     @М     @И     @Т     @Ь     @Б     @Ю     _     _
  @ctrl-ru     _     _                 _                 _     _     _
)

;;  Define additional keys specific to your keyboard layout for Windows
(defalias
  ;; ru-layout
  : S-;
  й (unicode й)
  ц (unicode ц)
  у (unicode у)
  к (unicode к)
  е (unicode е)
  н (unicode н)
  г (unicode г)
  ш (unicode ш)
  щ (unicode щ)
  з (unicode з)
  х (unicode х)
  ъ (unicode ъ)
  ф (unicode ф)
  ы (unicode ы)
  в (unicode в)
  а (unicode а)
  п (unicode п)
  р (unicode р)
  о (unicode о)
  л (unicode л)
  д (unicode д)
  ж (unicode ж)
  э (unicode э)
  я (unicode я)
  ч (unicode ч)
  с (unicode с)
  м (unicode м)
  и (unicode и)
  т (unicode т)
  ь (unicode ь)
  б (unicode б)
  ю (unicode ю)
  ё (unicode ё)

  Й (unicode Й)
  Ц (unicode Ц)
  У (unicode У)
  К (unicode К)
  Е (unicode Е)
  Н (unicode Н)
  Г (unicode Г)
  Ш (unicode Ш)
  Щ (unicode Щ)
  З (unicode З)
  Х (unicode Х)
  Ъ (unicode Ъ)
  Ф (unicode Ф)
  Ы (unicode Ы)
  В (unicode В)
  А (unicode А)
  П (unicode П)
  Р (unicode Р)
  О (unicode О)
  Л (unicode Л)
  Д (unicode Д)
  Ж (unicode Ж)
  Э (unicode Э)
  Я (unicode Я)
  Ч (unicode Ч)
  С (unicode С)
  М (unicode М)
  И (unicode И)
  Т (unicode Т)
  Ь (unicode Ь)
  Б (unicode Б)
  Ю (unicode Ю)
  Ё (unicode Ё)

  ru-e (tap-hold $tt $ht @е @ё)
  ru-E (tap-hold $tt $ht @Е @Ё)
)
