(deflayermap (motion)

  w up
  a left
  s down
  d rght

  i @mwu
  j @mwl
  k @mwd
  l @mwr

  p home
  ; end
  y pgup
  h pgdn


  / @slsh
  grv @chgrl
  tab @chtb
  esc @chesc
)

(deflayermap (arrows)

  w (unmod up)
  a (unmod left)
  s (unmod down)
  d (unmod rght)
  alt (unmod alt)
  e (multi alt tab)
  q tab
  caps (layer-switch qwerty)

  / @slsh
  grv @chgrl
  tab @chtb
  esc @chesc
)

(deflayermap (vim)
  q @dr0
  w @dr1
  e @dr2
  r @dr3

  a @dp0
  s @dp1
  d @dp2
  f @dp3

  x @dms

  c @cpy
  v @pst

  h left
  j down
  k up
  l rght

  / @slsh
  grv @chgrl
  tab @chtb
  esc @chesc

)


(deflayermap (layers)
  1 @qwr
  2 @ru
  3 lrld
  4 @macro-test
  5 @leisure
  0 @qwr_clean
  - @qwr_pure
  v @vim
  m (layer-switch motion)

  / @slsh
  grv @chgrl
  tab @chtb
  esc @chesc
)

(deflayermap (leisure)
  1 @drg
  2 @noita
  3 lrld
  t (layer-switch tf2)
  f (layer-switch fps)
  l (layer-switch lethal)
  d (layer-switch doom)

  / @slsh
  grv @chgrl
  tab @chtb
  esc @chesc
)

(deflayermap (doom)
  v lsft

  / @slsh
  grv @chgrl
  tab @chtb
  esc @chesc
)


(deflayermap (macro-test)
  q @mt1
  w @mt2
  e @mt3
  r @mt4

  h left
  j down
  k up
  l rght

  / @slsh
  grv @chgrl
  tab @chtb
  esc @chesc
)

(deflayermap (noita)
  q @first_spell
  z @tablet
  x @tablet_2
  v @tablet_v
  b @tablet_b
  t @potion_noita
  p (macro m 20 o 20 t 20 h 20 e 20 r 20 l 20 o 20 d 20 e)
  [ (macro s 20 e 20 c 20 o 20 n 20 d 20 a 20 m 20 e 20 n 20 d 20 m 20 e 20 n 20 t)

  / @slsh
  grv @chgrl
  tab @chtb
  esc @chesc
)


(deflayermap (lethal)
  w (macro-repeat mlft 25)
  a (macro-repeat r 1)
  q (macro-repeat r mlft 1)
  ;; lsft @tsft
  ;;lctrl @releaseSftPressCtrl


  / @slsh
  grv @chgrl
  tab @chtb
  esc @chesc
)

(deflayermap (drg)
  spc @drg-spc
  q @drg-lm
  g @nade
  n @ustck
  e @drg-e
  f @drg-zip
  r @drg-r
  lsft @lsft-f24
  caps f24
  lalt @drg-lalt
  [ @drg-[

  t (macro-repeat mlft 1 mlft 1 mlft 1 mlft 1 mlft 1 mlft 1 40 lctl 40)

  / @slsh
  grv @chgrl
  tab @chtb
  esc @chesc
)

(deflayermap (fps)
  / @slsh
  e w
  s a
  d s
  f d
  caps f24
  rsft (tap-hold $tt $ht  rsft (layer-toggle numpad))
  = (tap-hold $tt $ht + (layer-switch tf2-base))
)

(deflayermap (tf2)
  / @slsh

  q (switch
    ((key-history a 1)) d break
    () a break

  )

  1 (switch
    () (tap-hold $tt $ht (tap-dance 200 ( @tf2_1 home . ) ) 1) break
    ;; spy scout medic
  )
  2 (switch
    () (tap-hold $tt $ht (tap-dance 200 ( @tf2_2 pgup end ) ) 2) break
    ;; pyro demo soldier
  )
  3 (switch
    () (tap-hold $tt $ht (tap-dance 200 ( / del ) ) 3) break
    ;; sniper engineer
  )
  4 (switch
    () (tap-hold $tt $ht (tap-dance 200 ( pgdn ' 5 ) ) 4) break
    ;; heavy fscout manual disguise
  )

  5 (tap-hold $tt $ht 5 kp4)
  6 (tap-hold $tt $ht 6 kp2)
  7 (tap-hold $tt $ht 7 kp6)
  8 (tap-hold $tt $ht 8 kp5)
  9 (tap-hold $tt $ht 9 kp7)

  0 (tap-hold $tt $ht 0 f11)
  - (tap-hold $tt $ht - kp-)
  spc (switch
    (e) spc break
    (q) f10 break
    () f11 break
  )
  caps f24
  rsft (tap-hold $tt $ht  rsft (layer-toggle numpad))
  = (tap-hold $tt $ht + (layer-switch tf2-base))
)

(deflayermap (tf2-base)
  / @slsh
  - (tap-hold $tt $ht - kp-)
  spc (switch
    (e) spc break
    (q) f10 break
    () f11 break
  )
  caps f24
  rsft (tap-hold $tt $ht  rsft (layer-toggle numpad))
)

(defalias
  tf2_1 (chord tf2 tf2_1)
  tf2_2 (chord tf2 tf2_2)
)
(defchords tf2 200
    (tf2_1 tf2_2) kp-
    (tf2_1) ;
    (tf2_2) ins
)

(deflayermap (numpad)
  1 kp1
  2 kp2
  3 kp3
  4 kp4
  5 kp5
  6 kp6
  7 kp7
  8 kp8
  9 kp9
  0 kp0
  - kp-
  + kp+
)
